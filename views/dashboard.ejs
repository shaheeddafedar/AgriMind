 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Farmer Dashboard - AgriMind</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
   <header class="navbar">
    <div class="container">
        <a href="/" class="logo"><i class="fas fa-leaf"></i> AgriMind</a>

        <button class="mobile-menu-toggle" id="mobile-menu-toggle">
            <i class="fas fa-bars"></i>
        </button>

        <ul class="nav-links" id="nav-links">
            <li><a href="/"><%= __('nav_home') %></a></li>

            <% if (isLoggedIn) { %>
                <li id="dashboard-link"><a href="/dashboard"><%= __('nav_dashboard') %></a></li>
                <li><a href="/feedback"><%= __('nav_feedback') %></a></li>
            <% } else { %>
                <li id="dashboard-link" style="display:none;"><a href="/dashboard"><%= __('nav_dashboard') %></a></li>
            <% } %>
                <li><a href="/irrigation">Irrigation</a></li>
            <li><a href="/about"><%= __('nav_about') %></a></li>
            <li><a href="/analytics"><%= __('nav_analytics') %></a></li>
        </ul>

        <div class="auth-buttons">
            <% if (isLoggedIn && user) { %>
                <div class="user-nav-profile">
                    <img src="<%= user.profilePhoto %>" alt="User" class="nav-avatar">
                    <span class="nav-username"><%= user.name %> <i class="fas fa-caret-down"></i></span>
                    
                    <div class="user-dropdown-menu">
                        <a href="/profile"><i class="fas fa-user-circle"></i> View Profile</a>
                        <a href="/dashboard"><i class="fas fa-seedling"></i> Dashboard</a>
                        <!--<a href="/download-report"><i class="fas fa-file-pdf"></i> Download Report</a>-->
                        <form action="/logout" method="POST" style="margin: 0;">
                            <button type="submit" style="font-family: inherit;"><i class="fas fa-sign-out-alt"></i> Logout</button>
                        </form>
                    </div>
                </div>
            <% } else { %>
                <a href="#" class="btn btn-secondary" id="login-btn">Log In</a>
                <a href="/signup" class="btn" id="register-btn">Sign Up</a>
            <% } %>
        </div>

        <li class="dropdown" style="list-style: none; margin-left: 20px;">
            <a href="#" class="dropbtn">
                <i class="fas fa-globe"></i> Language
            </a>
            <div class="dropdown-content">
                <a href="/lang/en">English</a>
                <a href="/lang/hi">हिन्दी (Hindi)</a>
                <a href="/lang/kn">ಕನ್ನಡ (Kannada)</a>
            </div>
        </li>
    </div>
</header>

    <main class="container">
        <div class="dashboard-grid">
            <section class="main-content">
                <div class="recommendation-mode">
                <button type="button"
                        id="crop-mode-btn"
                        class="btn recommendation-mode-btn active">
                    🌾 Crop Recommendation
                </button>

                <button type="button"
                        id="fertilizer-mode-btn"
                        class="btn recommendation-mode-btn">
                    🧪 Fertilizer Recommendation
                </button>
            </div>

            <br>

            <h2 id="recommendation-title">Get a New Crop Recommendation</h2>

            <p id="recommendation-description">
                Fill in the details below to get an AI-powered crop suggestion.
            </p>
                <div class="farm-id-fetch">
                <div class="form-group">
                    <label for="farmId">Have a Farm Land ID? Fetch Details</label>
                    <div class="input-with-button">
                        <input type="text" id="farmId" placeholder="e.g., FARM101">
                        <button type="button" id="fetch-farm-details-btn" class="btn btn-secondary">Fetch</button>
                    </div>
                </div>
            </div>
                <form id="recommendation-form" action="recommend" method="POST" class="form-grid">
                    <div class="form-group crop-only-field">
                        <label for="soilPh">Soil pH (0-14)</label>
                        <input type="number" id="soilPh" step="0.1" min="0" max="14" required>
                    </div>
                    <div class="form-group crop-only-field">
                    <div class="form-group crop-only-field">
                    <label for="humidity">Humidity (%)</label>
                    <input
                        type="number"
                        id="humidity"
                        min="0"
                        max="100"
                        step="0.01"
                        required
                        disabled
                    >
                </div>
                </div>
                     <div class="form-group">
                        <label for="nitrogen">Nitrogen (kg/ha)</label>
                        <input type="number" id="nitrogen" min="0" required>
                    </div>
                    <div class="form-group">
                        <label for="phosphorus">Phosphorus (0-150 kg/ha)</label>
                        <input type="number" id="phosphorus" min="0" max="150" required>
                    </div>
                    <div class="form-group">
                        <label for="potassium">Potassium (0-200 kg/ha)</label>
                        <input type="number" id="potassium" min="0" max="200" required>
                    </div>
                    <div class="form-group crop-only-field">
                        <label for="temperature">Temperature (°C)</label>
                        <input type="number" id="temperature"  min="1" max="75" required disabled>
                    </div>
                     <div class="form-group crop-only-field">
                        <label for="rainfall">Annual Rainfall (0-5000 mm)</label>
                        <input type="number" id="rainfall" min="0" max="5000" required disabled>
                    </div>
                    <div class="form-group crop-only-field">
                    <label for="area">Area (hectares)</label>
                        <input type="number" id="area" step="0.1" min="0.1" required>
                    </div>
                    <div class="form-group crop-only-field">
                        <label for="city">City</label>
                        <select id="city" required disabled><option value="">Select City</option></select>
                    </div>
                    <div class="form-group crop-only-field">
                        <label for="state">State</label>
                        <select id="state" required><option value="">Select State</option></select>
                    </div>
                    <div class="form-group crop-only-field">
                    <label for="season">Season</label>
                        <select id="season" required>
                            <option value="">Select Season</option>
                            <option value="Kharif">Kharif(Monsoon Season)</option>
                            <option value="Rabi">Rabi(Winter Season)</option>
                            <option value="Zaid">Zaid(Short Summer Season)</option>
                        </select>
                    </div>
                    
                    <div class="form-group crop-only-field">
                        <label for="pastCrop">Past Crop Grown</label>
                        <input type="text" id="pastCrop" placeholder="e.g., Wheat" not required>
                    </div>

                    <div class="form-group fertilizer-only-field" id="fertilizer-crop-field">
                        <label for="fertilizerCrop">Crop</label>
                        <input type="text" id="fertilizerCrop" placeholder="e.g., Tomato">
                    </div>

                    <div class="form-group full-width">
                        <button type="submit" class="btn" id="recommendation-submit-btn">
                            Get Crop Recommendation
                        </button>
                    </div>
                </form>
            </section>

            <aside class="sidebar">
                <div class="sidebar-widget">
                    <h3><i class="fas fa-history"></i> Recent Recommendations</h3>
                    <div id="recent-recommendations">
                        <p>No recent history found.</p>
                    </div>
                </div>
                <div class="sidebar-widget">
                    <h3><i class="fas fa-comment-dots"></i> Chat Assistant</h3>
                    <div class="chatbot">
                        <div class="chat-window">
                            <div class="chat-message bot">Hello! How can I help you today?</div>
                        </div>
                        <div class="chat-input">
                            <input type="text" id="chat-query" placeholder="Ask about crops...">
                            <button id="ask-btn"><i class="fas fa-paper-plane"></i></button>
                        </div>
                    </div>
                </div>
                       <div class="chatbot-tips">
            <p><strong>Try asking:</strong></p>
            <ul>
                <li>Fertilizer for wheat</li>
                <li>Best time to plant rice</li>
                <li>What is soil pH?</li>
                <li>What is kharif season</li>
                <li>What is rabi season</li>
                <li>What is soil ph</li>
                <li>How to increase soil ph</li>
                <li>How to decrease soil ph</li>
            </ul>
        </div>
            </aside>
        </div>
    </main>


    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <a href="/" class="logo"><i class="fas fa-leaf"></i> AgriMind</a>
                    <p>Empowering farmers with AI-driven agricultural insights.</p>
                </div>
                <div class="footer-links">
                    <div class="footer-column">
                        <h4>Quick Links</h4>
                        <ul>
                            <li><a href="/">Home</a></li>
                            <li><a href="/dashboard">Dashboard</a></li>
                            <li><a href="/about">About</a></li>
                        </ul>
                    </div>
                    <div class="footer-column">
                        <h4>Resources</h4>
                        <ul>
                            <li><a href="/analytics">Analytics</a></li>
                            <li><a href="/feedback">Feedback</a></li>
                            <li><a href="#">Help Center</a></li>
                        </ul>
                    </div>
                    <div class="footer-column">
                        <h4>Contact</h4>
                        <ul>
                            <li><a href="mailto:support@agrimind.dev">support@agrimind.dev</a></li>
                            <li><a href="tel:+911234567890">+91 123 456 7890</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 AgriMind. All Rights Reserved.</p>
                <div class="social-icons">
                    <a href="#" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
                    <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin"></i></a>
                </div>
            </div>
        </div>
    </footer>
<script>
    const USER_ID = '<%= userId %>';
</script>

    <script src="/js/api.js"></script>
    <script src="/js/dashboard.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>  



